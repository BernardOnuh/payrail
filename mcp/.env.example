# Payrail MCP server — configuration

# Payrail HTTP API
PAYRAIL_API_URL=http://localhost:3000
PAYRAIL_API_KEY=
PAYRAIL_MCP_CHAIN=testnet
PAYRAIL_MCP_SLIPPAGE_BPS=50

# Demo signer (OPTIONAL, disabled by default)
# NEVER put a funded production key here.
MCP_SIGNER_ENABLED=false
MCP_SIGNER_PRIVATE_KEY=
# Signing cap in USDC base units (6 decimals), e.g. 5000000 = 5 USDC
MCP_SIGNER_MAX_TOTAL_USDC=5000000
# Set to 1 to broadcast + await receipts (1 receipt = final on Arc)
MCP_SIGNER_BROADCAST=0
# Optional NDJSON file; every signature is appended here
MCP_SIGNER_LOG_FILE=