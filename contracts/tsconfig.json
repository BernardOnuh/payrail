{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "noEmit": true
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts", "hardhat.config.ts", "typechain-types"]
}