# Payrail API server config (loaded from ./.env at boot)
# Copy to .env and adjust. Absolute values are real testnet/Base demo values.

PAYRAIL_PORT=3033

# Writable SQLite path. Use a persistent volume on a host (never an
# ephemeral filesystem).
PAYRAIL_DB_PATH=./payrail.sqlite

# Quote TTL in seconds; the network the web UI reports (info only).
PAYRAIL_QUOTE_TTL_SECONDS=300

# Operators can call /v1/keys on behalf of other wallets.
PAYRAIL_OPERATOR_KEY=set-a-random-secret

# Public URL the API advertises in its OpenAPI spec (e.g. your Railway URL).
PUBLIC_API_URL=http://localhost:3033

# PayrailRouter contract per chain (mainnet requires an existing deployment).
PAYRAIL_ROUTER_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
PAYRAIL_ROUTER_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
PAYRAIL_ROUTER_ADDRESS_BASESEPOLIA=0x1b4b2ece12d188d3235c2c1df31cce249d81aff9