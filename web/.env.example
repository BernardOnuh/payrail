# Payrail web app environment
# Copy to .env and adjust. Nothing here is secret, but the API KEY below MUST
# never be shipped to a browser — it is read only in server route handlers.

# --- Data source ------------------------------------------------------------
# mock = built-in mock provider (no Payrail API running), api = real HTTP API.
PAYRAIL_MODE=mock

# Real API mode (PAYRAIL_MODE=api):
PAYRAIL_API_URL=http://localhost:3000
PAYRAIL_API_KEY=

# Mock tuning (optional)
PAYRAIL_MOCK_QUOTE_TTL_SECONDS=120
PAYRAIL_MOCK_CONFIRM_MS=1400

# --- Arc chains (wagmi reads these; NOT hardcoded in source) ----------------
# Public endpoints / ids; overridable for local forks.
NEXT_PUBLIC_CHAIN_MAINNET_ID=5042
NEXT_PUBLIC_CHAIN_MAINNET_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_CHAIN_MAINNET_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_CHAIN_TESTNET_ID=5042002
NEXT_PUBLIC_CHAIN_TESTNET_RPC=https://rpc.testnet.arc.io
NEXT_PUBLIC_CHAIN_TESTNET_EXPLORER=https://explorer.testnet.arc.io
NEXT_PUBLIC_CHAIN_BASESEPOLIA_ID=84532
NEXT_PUBLIC_CHAIN_BASESEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_BASESEPOLIA_EXPLORER=https://sepolia.basescan.org
NEXT_PUBLIC_CHAIN_BASE_ID=8453
NEXT_PUBLIC_CHAIN_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_CHAIN_BASE_EXPLORER=https://basescan.org

# Default chain the "New payout" screen preselects.
NEXT_PUBLIC_PAYRAIL_DEFAULT_CHAIN=testnet